{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["worker", "shared"],
  "exclude": ["**/*.test.ts"]
}
